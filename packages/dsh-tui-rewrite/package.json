{
  "name": "dsh-tui-rewrite",
  "version": "0.0.1",
  "description": "User-driven rewriting of assistant replies on the model-visible surface, leaving the append-only session log untouched.",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-tui",
    "deepseek-harness",
    "cordis",
    "plugin",
    "tui"
  ],
  "main": "src/main.js",
  "types": "src/main.d.ts",
  "exports": {
    ".": {
      "types": "./src/main.d.ts",
      "default": "./src/main.js"
    },
    "./projection": {
      "types": "./src/projection.d.ts",
      "default": "./src/projection.js"
    },
    "./scene": {
      "types": "./src/scene.d.ts",
      "default": "./src/scene.js"
    },
    "./i18n": {
      "types": "./src/i18n.d.ts",
      "default": "./src/i18n.js"
    },
    "./debug": {
      "types": "./src/debug.d.ts",
      "default": "./src/debug.js"
    },
    "./seam": {
      "types": "./src/seam.d.ts",
      "default": "./src/seam.js"
    },
    "./persist": {
      "types": "./src/persist.d.ts",
      "default": "./src/persist.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./dsh-plugin.json": "./dsh-plugin.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "dsh-plugin.json"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-harness-tui/dsh-tui": ">=0.15.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiaohaigui/dsh-tui-rewrite.git",
    "directory": "packages/dsh-tui-rewrite"
  },
  "homepage": "https://github.com/xiaoxiaohaigui/dsh-tui-rewrite#readme",
  "bugs": {
    "url": "https://github.com/xiaoxiaohaigui/dsh-tui-rewrite/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
